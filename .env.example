# Telegram API Credentials
# Obtenha em: https://my.telegram.org/auth/login
API_ID=
API_HASH=

# MongoDB Atlas Connection String
# Formato: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Obtenha em: https://cloud.mongodb.com
MONGO_URI=

# Control Group ID (seu grupo privado para comandos e alertas)
# Use um bot Telegram para descobrir: /id
# O valor é negativo para grupos: -1001234567890
CONTROL_GROUP_ID=
